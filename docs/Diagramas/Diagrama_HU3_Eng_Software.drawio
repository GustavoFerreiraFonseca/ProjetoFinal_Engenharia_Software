        <mxCell id="vGaqKjKqJyvV9028w97v-46" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;verticalAlign=middle;spacing=8;fontSize=11;" value='&lt;b&gt;Motor de Verificação ACWR e Pace Crônico&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;classificar_acwr(perfil)&lt;/font&gt;&lt;div style="text-align:left;margin-top:4px;"&gt;• 1.3 &amp;lt; ACWR &amp;lt;= 1.5: Atenção&lt;br&gt;• ACWR &amp;gt; 1.5: Zona de perigo&lt;br&gt;• ACWR &amp;lt;= 1.3 ou None: sem alerta&lt;/div&gt;&lt;div style="margin-top:8px;"&gt;&lt;font face="Courier New"&gt;classificar_pace(perfil)&lt;/font&gt;&lt;/div&gt;&lt;div style="text-align:left;margin-top:4px;"&gt;• diferença = (pace_cronico − pace_agudo) / pace_cronico × 100 (1 casa)&lt;br&gt;• diferença &amp;gt;= 15 (só pace mais rápido): alerta&lt;br&gt;• pace crônico None: sem alerta&lt;/div&gt;' vertex="1"><mxGeometry x="190" y="1160" width="420" height="190" as="geometry" /></mxCell>
        <mxCell id="vGaqKjKqJyvV9028w97v-62" edge="1" parent="1" source="vGaqKjKqJyvV9028w97v-27" target="vGaqKjKqJyvV9028w97v-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
