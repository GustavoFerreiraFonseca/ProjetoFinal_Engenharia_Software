        <mxCell id="vGaqKjKqJyvV9028w97v-27" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;verticalAlign=middle;spacing=8;fontSize=11;" value='&lt;b&gt;Cálculo ACWR&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New"&gt;calcular_acwr(perfil)&lt;/font&gt;&lt;div style="text-align:left;margin-top:4px;"&gt;• acwr = volume_agudo / volume_cronico (2 casas)&lt;br&gt;• volume_cronico None ou 0: acwr = None&lt;/div&gt;' vertex="1"><mxGeometry x="250" y="990" width="300" height="100" as="geometry" /></mxCell>
