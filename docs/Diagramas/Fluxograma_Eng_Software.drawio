        <mxCell id="e-banco-cronico" value="semana atual&lt;br&gt;+ 3 anteriores" style="edgeStyle=none;rounded=0;html=1;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;" edge="1" parent="1" source="banco" target="cronico"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="510" /><mxPoint x="1090" y="890" /></Array></mxGeometry></mxCell>
