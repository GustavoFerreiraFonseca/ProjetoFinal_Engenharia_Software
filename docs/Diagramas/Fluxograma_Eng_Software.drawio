        <mxCell id="titulo" value="&lt;b&gt;Fluxograma da Aplicação&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=28;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="430" y="45" width="900" height="50" as="geometry" /></mxCell>
        <mxCell id="entrada" value="ENTRADA&lt;br&gt;arquivo .csv" style="whiteSpace=wrap;html=1;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1" parent="1"><mxGeometry x="50" y="170" width="100" height="80" as="geometry" /></mxCell>
        <mxCell id="leitura" value="&lt;b&gt;Leitura do CSV&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;AnalisadorLesoes.de_csv(caminho_csv)&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• lê o histórico inteiro de uma vez (processar_linha_csv, HU 1)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• ignora o cabeçalho e as linhas inválidas&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="165" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="treinos" value="&lt;b&gt;LISTA DE TREINOS&lt;/b&gt;&lt;br&gt;[ {data, distancia,&lt;br&gt;tempo, freq_cardiaca} ]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;fontSize=11;" vertex="1" parent="1"><mxGeometry x="415" y="300" width="160" height="110" as="geometry" /></mxCell>
        <mxCell id="recuperacao" value="&lt;b&gt;Motor de Verificação de Recuperação&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;verificar_recuperacao()&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• percorre todas as datas do histórico&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• dois treinos no mesmo dia contam como um dia&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• um alerta para cada sequência&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="300" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="alerta-rec" value="&lt;b&gt;Emitir Alerta&lt;/b&gt;&lt;br&gt;ALERTA (recuperação): treinos em N&lt;br&gt;dias seguidos, de DD/MM/AAAA a&lt;br&gt;DD/MM/AAAA. Agende um dia de descanso." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1090" y="300" width="240" height="110" as="geometry" /></mxCell>
        <mxCell id="montar" value="&lt;b&gt;Montagem das Semanas&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;montar_semanas(treinos)&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• agruparSemana e indentificarDomingo (HU 2)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• completa as semanas sem treino com [ ] (0 km)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="460" width="330" height="100" as="geometry" /></mxCell>
        <mxCell id="banco" value="&lt;b&gt;BANCO DE SEMANAS&lt;/b&gt;&lt;br&gt;[ {&amp;quot;Semana DD/MM/AAAA:&amp;quot;: [treinos]} ]&lt;br&gt;todas as semanas, da primeira à última&lt;br&gt;semana sem treino = [ ] (0 km)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="440" width="280" height="140" as="geometry" /></mxCell>
        <mxCell id="laco" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="1020" height="945" as="geometry" /></mxCell>
        <mxCell id="laco-titulo" value="&lt;b&gt;analisar(): repete para cada semana do banco&lt;/b&gt;&lt;br&gt;cada semana gera um perfil novo" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;align=left;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="470" height="40" as="geometry" /></mxCell>
        <mxCell id="agudo" value="&lt;b&gt;Cálculo Volume Agudo e Pace Agudo&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;calcular_volume_pace_agudo(indice, perfil)&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• volume_agudo = soma das distâncias da semana&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• pace_agudo = média dos paces (tempo / distância)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• semana sem treino: 0.0 km e pace None&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="690" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="cronico" value="&lt;b&gt;Cálculo Volume Crônico e Pace Crônico&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;calcular_volume_pace_cronico(indice, perfil)&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• usa a semana atual e as 3 anteriores&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• volume_cronico = soma das distâncias / 4&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• pace_cronico = média dos paces de todos os treinos&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• menos de 4 semanas (indice &amp;lt; 3): continua None&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="830" width="400" height="120" as="geometry" /></mxCell>
        <mxCell id="perfil" value="&lt;b&gt;PERFIL DA SEMANA&lt;/b&gt;&lt;br&gt;semana&lt;br&gt;volume_agudo&lt;br&gt;pace_agudo&lt;br&gt;volume_cronico&lt;br&gt;pace_cronico&lt;br&gt;acwr&lt;br&gt;classificacao&lt;br&gt;(float, str ou None)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="700" width="210" height="220" as="geometry" /></mxCell>
        <mxCell id="acwr" value="&lt;b&gt;Cálculo ACWR&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;calcular_acwr(perfil)&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• acwr = volume_agudo / volume_cronico (2 casas)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• volume_cronico None ou 0: acwr = None&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="980" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="classificar" value="&lt;b&gt;Motor de Classificação ACWR e Pace&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;classificar_acwr(perfil)&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• ACWR None: Sem base de comparação (sem alerta)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• ACWR &amp;lt; 0.8: Abaixo da zona segura&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• 0.8 &amp;lt;= ACWR &amp;lt;= 1.3: Zona segura&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• 1.3 &amp;lt; ACWR &amp;lt;= 1.5: Atenção&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• ACWR &amp;gt; 1.5: Zona de perigo&lt;/div&gt;&lt;font face=&quot;Courier New&quot;&gt;classificar_pace(perfil)&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• diferença = (pace_cronico − pace_agudo) / pace_cronico × 100&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• diferença &amp;gt;= 15 (só pace mais rápido): alerta&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• pace None: sem alerta&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="185" y="1110" width="420" height="215" as="geometry" /></mxCell>
        <mxCell id="alerta-vol" value="&lt;b&gt;Emitir Alerta&lt;/b&gt;&lt;br&gt;ATENÇÃO (volume): X km nesta semana contra média de&lt;br&gt;Y km nas últimas 4 semanas (ACWR Z).&lt;br&gt;&lt;br&gt;ALERTA (volume): X km nesta semana contra média de Y km&lt;br&gt;nas últimas 4 semanas (ACWR Z). Zona de perigo para lesões.&lt;br&gt;&lt;br&gt;ALERTA (ritmo): pace médio da semana de M:SS min/km, D%&lt;br&gt;mais rápido que a média das últimas 4 semanas (M:SS min/km)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="185" y="1380" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="notificar" value="&lt;b&gt;Observer&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;notificar(semana, mensagem)&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• avisa todos os observadores cadastrados&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• cadastro: adicionar_observador(observador)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="1410" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="terminal" value="&lt;b&gt;AlertaTerminal&lt;/b&gt;&lt;br&gt;imprime o alerta no terminal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="1500" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="coletor" value="&lt;b&gt;ColetorAlertas&lt;/b&gt;&lt;br&gt;guarda os alertas em uma lista&lt;br&gt;(relatório e testes)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="1600" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="relatorio" value="&lt;b&gt;Gerar Relatório Final (.txt)&lt;/b&gt;&lt;br&gt;lista de perfis (um por semana) + alertas coletados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="185" y="1620" width="420" height="70" as="geometry" /></mxCell>
